# Your Anthropic API key; leave it empty to use the demo only (no API calls, no costs).
ANTHROPIC_API_KEY=
# Monthly spending limit in US dollars; paid calls stop when it is reached.
MONTHLY_LIMIT_USD=5
# Password for the web app; needed when it listens on another address than 127.0.0.1 and a key is set.
APP_PASSWORD=
# Extra host names the web app accepts, separated by commas (for a reverse proxy); a wildcard (*) needs APP_PASSWORD.
SKILLPOSE_ALLOWED_HOSTS=
# Folder with your own prompts (cv.md, job.md, relation.md, path.md); empty = the example prompts of the package.
SKILLPOSE_PROMPTS=
# The log file (no texts, see README "Operation"); empty = skillpose.log next to the database, off = no log file.
SKILLPOSE_LOG=
